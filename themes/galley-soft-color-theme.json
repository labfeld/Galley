  "tokenColors": [
    {
      "name": "Text",
      "settings": {
        "foreground": "#2C2824",
        "background": "#F6F3EE"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#4A453F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Notes",
      "scope": [
        "comment.note.notation",
        "comment.note.notation.galley"
      ],
      "settings": {
        "foreground": "#124A89",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Action tags",
      "scope": [
        "keyword.codetag.notation",
        "keyword.codetag.notation.galley"
      ],
      "settings": {
        "foreground": "#614509",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc annotations",
      "scope": [
        "storage.type.annotation.galley"
      ],
      "settings": {
        "foreground": "#124A89",
        "fontStyle": "italic"
      }
    },
    {
