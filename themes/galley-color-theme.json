  "tokenColors": [
    {
      "name": "Text",
      "settings": {
        "foreground": "#EFEBE1",
        "background": "#1A1510"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#B2B8BF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Notes",
      "scope": [
        "comment.note.notation",
        "comment.note.notation.galley"
      ],
      "settings": {
        "foreground": "#96B9EE",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Action tags",
      "scope": [
        "keyword.codetag.notation",
        "keyword.codetag.notation.galley"
      ],
      "settings": {
        "foreground": "#E9D897",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc annotations",
      "scope": [
        "storage.type.annotation.galley"
      ],
      "settings": {
        "foreground": "#96B9EE",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#96B9EE",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.relational",
        "keyword.operator.logical",
        "keyword.operator.bitwise",
        "keyword.operator.ternary",
        "keyword.operator.arrow",
        "storage.type.function.arrow",
        "punctuation.accessor",
        "punctuation.separator.pointer-access"
      ],
      "settings": {
        "foreground": "#C4B8A8",
        "fontStyle": ""
      }
    },
    {
      "name": "Word operators",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.typeof",
        "keyword.operator.instanceof",
        "keyword.operator.void",
        "keyword.operator.delete",
        "keyword.operator.in",
        "keyword.operator.of",
        "keyword.operator.as",
        "keyword.operator.is",
        "keyword.operator.keyof",
        "keyword.operator.infer",
        "keyword.operator.satisfies",
        "keyword.operator.word",
        "keyword.operator.type",
        "keyword.operator.logical.python"
      ],
      "settings": {
        "foreground": "#96B9EE",
        "fontStyle": ""
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.definition",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.section",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#AFA598",
        "fontStyle": ""
      }
    },
    {
      "name": "Interpolation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "punctuation.definition.interpolation"
      ],
      "settings": {
        "foreground": "#96B9EE",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#EEAC8B",
        "fontStyle": ""
      }
    },
    {
      "name": "Escapes",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#E9D897",
        "fontStyle": ""
      }
    },
    {
      "name": "Regexp",
      "scope": [
        "string.regexp",
        "string.regexp source"
      ],
      "settings": {
        "foreground": "#E9D897",
        "fontStyle": ""
      }
    },
    {
      "name": "Regexp operators",
      "scope": [
        "string.regexp keyword.operator",
        "keyword.operator.quantifier.regexp",
        "constant.other.character-class.regexp",
        "punctuation.definition.character-class.regexp"
      ],
      "settings": {
        "foreground": "#96B9EE",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers and literals",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#E9D897",
        "fontStyle": ""
      }
    },
